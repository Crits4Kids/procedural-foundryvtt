# Copy to .env and fill in (do not commit .env).

# Host port for the test Foundry instance. Your live desktop app defaults to
# 30000, so this defaults to 30001 to avoid colliding with it.
FOUNDRY_TEST_PORT=30001

# Foundry version to install in the container, matching system.json's
# compatibility.verified.
FOUNDRY_VERSION=14

# --- Auth: pick ONE method ---

# Method 1: Foundry account credentials. Only works if 2FA is off.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Method 2: timed release download URL (required if 2FA is on). Get one from
# https://foundryvtt.com/community/<your-username>/licenses, then uncomment
# FOUNDRY_RELEASE_URL in docker-compose.yml and set it here. It expires after
# a few hours, so you'll need a fresh one each time you rebuild the container
# (not needed for normal start/stop, only if you delete the data volume).
# FOUNDRY_RELEASE_URL=

# Sets the local admin-access key for the Setup screen (optional but
# recommended so the test instance isn't wide open).
FOUNDRY_ADMIN_KEY=
